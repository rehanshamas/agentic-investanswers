{
  "name": "agentic-investanswers",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "check": "nx affected -t lint test typecheck",
    "parity": "tsx apps/hydration/src/parity.ts",
    "backfill": "tsx --env-file-if-exists=.env apps/hydration/src/backfill.ts",
    "cook": "tsx apps/hydration/src/cook.ts",
    "rebuild-check": "tsx apps/hydration/src/rebuild-check.ts",
    "owner-inputs": "node scripts/owner-inputs.mjs",
    "status": "node scripts/status.mjs"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "24.0.2",
    "@types/node": "^22.20.5",
    "eslint": "10.13.0",
    "nx": "24.0.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "nx"
    ]
  }
}
